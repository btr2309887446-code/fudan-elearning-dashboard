{
  "name": "fudan-elearning-dashboard",
  "version": "0.12.0",
  "description": "复旦大学 eLearning (Canvas) 课程 / 作业 / 成绩 图形化看板",
  "main": "./out/main/index.js",
  "author": "ksar",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "electron-vite build && node scripts/dist.mjs",
    "demo": "electron-vite build && electron . --demo",
    "doctor": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/doctor.ts",
    "test:login-harness": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/login-harness.mjs",
    "test:cache": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/test-cache.ts",
    "test:files": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/test-files.ts",
    "test:summary": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/test-summary.ts",
    "test:ignored": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/test-ignored.ts",
    "test:refresh": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/test-refresh.ts",
    "test:download": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/test-download.ts",
    "test": "npm run test:files && npm run test:summary && npm run test:ignored && npm run test:refresh && npm run test:download && npm run test:cache && npm run test:workspace && npm run test:course-introduction && npm run test:lectures && npm run test:credentials",
    "cli": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/snapshot.ts",
    "test:workspace": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/test-workspace.ts",
    "test:workspace-ui": "npm run build && node scripts/test-workspace-ui.mjs",
    "demo:interaction": "electron-vite build && node scripts/run-feedback-demo.mjs",
    "test:course-introduction": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/test-course-introduction.ts",
    "test:lectures": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/test-lectures.ts",
    "test:course-ui": "npm run build && node scripts/test-course-content-ui.mjs",
    "postinstall": "node node_modules/electron/install.js",
    "test:credentials": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/test-credentials.ts",
    "test:lecture-budget": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/benchmark-lecture-cache.ts",
    "test:stability-ui": "npm run build && node scripts/test-stability-ui.mjs"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "echarts-for-react": "^3.0.2",
    "katex": "0.19.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sql.js": "^1.15.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "katex": "$katex"
  }
}
