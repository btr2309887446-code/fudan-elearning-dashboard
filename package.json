{
  "name": "fudan-elearning-dashboard",
  "version": "0.9.1",
  "description": "复旦大学 eLearning (Canvas) 课程 / 作业 / 成绩 图形化看板",
  "main": "./out/main/index.js",
  "author": "ksar",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "electron-vite build && node scripts/dist.mjs",
    "demo": "electron-vite build && electron . --demo",
    "doctor": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/doctor.ts",
    "test:cache": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/test-cache.ts",
    "test:files": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/test-files.ts",
    "test:summary": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/test-summary.ts",
    "test:ignored": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/test-ignored.ts",
    "test:refresh": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/test-refresh.ts",
    "test:download": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/test-download.ts",
    "test": "npm run test:files && npm run test:summary && npm run test:ignored && npm run test:refresh && npm run test:download && npm run test:cache",
    "cli": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cli/snapshot.ts"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
